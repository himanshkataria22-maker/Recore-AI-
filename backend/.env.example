# ==========================================
# ReCore AI Backend Configuration
# ==========================================

# LLM Provider: 'gemini' (default) or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional alternative)
GROQ_API_KEY=your_groq_api_key_here

# Offline Demo Mode: when 'true', all LLM responses are served from disk cache
DEMO_MODE=true

# Server Host & Port
HOST=0.0.0.0
PORT=8000
